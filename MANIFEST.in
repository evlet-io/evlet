include README.md AGENTS.md requirements-dev.lock requirements-server.lock requirements-s3.lock requirements-mcp.in requirements-mcp.lock requirements-postgres.lock
recursive-include docs *.md *.json
recursive-include examples *.py
recursive-include tests *.py
recursive-include scripts *.py *.sh
include frontend/package.json frontend/package-lock.json frontend/index.html frontend/vite.config.js
include frontend/.node-version frontend/.npmrc
recursive-include frontend/src *.js *.ts *.tsx *.css *.json
recursive-include frontend/legacy *.js *.vue *.css *.json
recursive-include frontend/scripts *.mjs
recursive-include frontend/public *.svg
include frontend/tsconfig.json
recursive-include evlet/ui/static *.html *.js *.css *.svg
recursive-include evlet *.pyi py.typed
include build_support.py
recursive-include evlet/resources *.tpl
exclude docs/handoff.md
