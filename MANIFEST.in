include README.md AGENTS.md requirements-dev.lock requirements-server.lock requirements-s3.lock
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
recursive-include scripts *.py *.sh
include frontend/package.json frontend/package-lock.json frontend/index.html frontend/vite.config.js
include frontend/.node-version frontend/.npmrc
recursive-include frontend/src *.js *.vue *.css *.json
