from typing import Any, Mapping, Sequence, TypedDict, Unpack
from .expressions import Binding, Expression, Operation

Event = Operation | Sequence[Operation]

class ComponentProps(TypedDict, total=False):
    id: str
    name: str
    children: Sequence[Component]
    slots: Mapping[str, Sequence[Component]]
    bindings: Mapping[str, Binding]
    events: Mapping[str, Event]
    class_name: str
    style: Mapping[str, Any]
    visible: bool | Expression
    disabled: bool | Expression
    width: int
    aria_label: str
    title: str
    label: str
    text: Any
    description: str
    value: Any
    variant: str
    tone: str
    gap: int
    padding: int
    columns: int | Sequence[Any]
    align: str
    justify: str
    wrap: bool
    level: int
    src: str
    alt: str
    initials: str
    max: int | float
    min: int | float
    step: str
    required: bool | Expression
    help: str
    error: str
    placeholder: str
    max_length: int
    options: Sequence[Any]
    items: Sequence[Any]
    rows: int
    multiple: bool
    icon: str
    open: bool
    source: Mapping[str, Any]
    empty_text: str
    total: int
    page_size: int
    offset: int
    action: str
    on_click: Event
    on_change: Event
    on_input: Event
    on_focus: Event
    on_blur: Event
    on_select: Event
    on_submit: Event
    on_open: Event
    on_close: Event

class Component:
    type: str
    id: str | None
    props: dict[str, Any]
    events: dict[str, Event]
    bindings: dict[str, Binding]
    slots: dict[str, list[Component]]
    @property
    def children(self) -> list[Component]: ...
    def __init__(self, type: str, **props: Any) -> None: ...
    def __getattr__(self, key: str) -> Any: ...
    def __setattr__(self, key: str, value: Any) -> None: ...
    def walk(self) -> Any: ...
    def find(self, component_id: str) -> Component: ...
    def field(self, name: str) -> Component: ...
    def add(
        self, component: Component, *, after: str | None = ..., slot: str = ...
    ) -> Component: ...
    def insert(self, index: int, component: Component) -> Component: ...
    def remove(self, component_id: str) -> Component: ...
    def replace(self, component_id: str, component: Component) -> Component: ...

class View:
    name: str
    kind: str
    route: str | None
    title: str
    subtitle: str
    layout: Component
    model: type | None
    state: dict[str, Any]
    computed: dict[str, Expression]
    options: dict[str, Any]
    def __init__(
        self,
        name: str | None = ...,
        *,
        route: str | None = ...,
        title: str | None = ...,
        subtitle: str = ...,
        layout: Component | None = ...,
        model: type | None = ...,
        state: Mapping[str, Any] | None = ...,
        computed: Mapping[str, Expression] | None = ...,
        roles: Sequence[str] = ...,
        requires: Sequence[str | type] = ...,
        icon: str = ...,
        section: str = ...,
        **options: Any,
    ) -> None: ...
    def add(
        self, component: Component, *, after: str | None = ..., slot: str = ...
    ) -> Component: ...
    def remove(self, component_id: str) -> Component: ...
    def find(self, component_id: str) -> Component: ...
    def replace(self, component_id: str, component: Component) -> Component: ...
    def field(self, name: str) -> Component: ...

class PageView(View): ...
class DashboardView(View): ...
class ListView(View): ...
class FormView(View): ...
class DetailView(View): ...

def Text(text: Any = ..., /, **props: Unpack[ComponentProps]) -> Component: ...
