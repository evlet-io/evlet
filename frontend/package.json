{
  "name": "evlet-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "npm run typecheck && vite build && node scripts/install-ui.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@primeuix/themes": "1.2.5",
    "primevue": "4.5.5",
    "vue": "3.5.44",
    "vite-plugin-solid": "2.11.14",
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "prettier": "3.9.10"
  }
}
