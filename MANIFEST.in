include README.md CHANGELOG.md build_support.py
include docs/*.md
include examples/playground/*.py
recursive-include examples/playground/portal *.html *.css *.js
include frontend/package.json frontend/package-lock.json frontend/index.html frontend/vite.config.js
include frontend/.node-version frontend/.npmrc frontend/tsconfig.json
recursive-include frontend/src *.ts *.css *.json
prune frontend/src/evlet/tests
recursive-include frontend/scripts *.mjs
recursive-include frontend/public *.svg
recursive-include frontend/fonts *.woff2 *.txt
recursive-include evlet/ui/static *.html *.js *.css *.svg *.woff2 *-OFL.txt
recursive-include evlet *.pyi py.typed
recursive-include evlet/resources *.tpl *.woff2 *-OFL.txt
prune tests
