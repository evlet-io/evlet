{
  "name": "evlet-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "npm run typecheck && vite build && node scripts/install-ui.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:ui": "node --experimental-transform-types --no-warnings scripts/bench-ui.mjs"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
